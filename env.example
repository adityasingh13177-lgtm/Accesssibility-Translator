# --- Node server ---
PORT=4000

# --- AI engine: choose ONE ---
# 1) Free, private, runs on your own computer (needs Ollama: https://ollama.com):
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b          # best all-round fit for a 6 GB GPU (RTX 3050). Run once:  ollama pull qwen3.5:4b
OLLAMA_NUM_CTX=16384             # lower to 8192 if `npm run ollama:check` says part of the model is on the CPU
# OLLAMA_URL=http://127.0.0.1:11434

# 2) Anthropic Claude (paid API key from console.anthropic.com). To use it, set LLM_PROVIDER=anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...     # server only, never in the React app
# MODEL=claude-sonnet-5-5

# 3) Any OpenAI-compatible service, for example Google Gemini's free tier. To use it, set LLM_PROVIDER=openai:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-key
# LLM_MODEL=gemini-2.5-flash

# --- PDF / photo / web-link reader (optional, needs Python + Tesseract) ---
EXTRACTOR_URL=http://127.0.0.1:8001
INTERNAL_KEY=change-me-long-random  # shared secret between Node and the Python extractor
MONGO_URI=
OCR_LANGS=eng
